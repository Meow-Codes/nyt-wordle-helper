{
  "name": "Wordle Wiz",
  "description": "Your wordle copilot",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": ["storage"],
  "action": {
    "default_title": "Wordle Wiz",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.nytimes.com/games/*"],
      "js": ["main.js"],
      "run_at": "document_idle"
    }
  ]
}